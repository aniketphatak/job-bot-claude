{
  "manifest_version": 3,
  "name": "JobBot - Smart Job Application Assistant",
  "version": "1.0.0",
  "description": "One-click job applications with AI-powered auto-fill for LinkedIn, Indeed, and more",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://www.linkedin.com/*",
    "*://www.indeed.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.workday.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.linkedin.com/jobs/*",
        "*://www.linkedin.com/jobs/view/*"
      ],
      "js": ["content-scripts/common.js", "content-scripts/linkedin.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.indeed.com/viewjob*",
        "*://www.indeed.com/m/jobs*"
      ],
      "js": ["content-scripts/common.js", "content-scripts/indeed.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["styles/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
